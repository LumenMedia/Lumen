<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Lumen</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\Lumen.ico')">Assets\Lumen.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseRidGraph>true</UseRidGraph>
    <EnablePreviewMsixTooling>true</EnablePreviewMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Version>1.0.0-rc.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <InformationalVersion>1.0.0-rc.1</InformationalVersion>
    <FileVersion>1.0.0.1</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Assets\**" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png;Assets\**\*.jpg;Assets\**\*.jpeg;Assets\**\*.webp;Assets\**\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AutoSync\ggml-tiny.bin"
             Condition="Exists('Assets\AutoSync\ggml-tiny.bin')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <!-- Prevent stale generated XAML when updating an existing working tree. -->
  <Target Name="PurgeStaleLumenGeneratedXaml" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\PlayerPage.g.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\PlayerPage.g.i.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\HomePage.g.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\HomePage.g.i.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\ItemPage.g.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\ItemPage.g.i.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\SettingsPage.g.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\SettingsPage.g.i.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\LibraryPage.g.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\LibraryPage.g.i.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\SearchPage.g.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\SearchPage.g.i.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\BrowsePage.g.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\BrowsePage.g.i.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\PersonPage.g.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\PersonPage.g.i.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\DownloadsPage.g.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\DownloadsPage.g.i.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\MusicPlayerPage.g.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\MusicPlayerPage.g.i.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\MusicAlbumPage.g.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\MusicAlbumPage.g.i.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\ArtistPage.g.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\ArtistPage.g.i.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\MusicLibraryPage.g.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\MusicLibraryPage.g.i.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\MusicPlaylistPage.g.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\Views\MusicPlaylistPage.g.i.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\MainWindow.g.cs" />
      <_StaleLumenGenerated Include="$(BaseIntermediateOutputPath)**\MainWindow.g.i.cs" />
    </ItemGroup>
    <Delete Files="@(_StaleLumenGenerated)" />
  </Target>

</Project>
