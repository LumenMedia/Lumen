<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Lumen.Converters">

    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <SolidColorBrush x:Key="LumenBackgroundBrush" Color="#0B0C10" />
    <SolidColorBrush x:Key="LumenSidebarBrush" Color="#111319" />
    <SolidColorBrush x:Key="LumenSurfaceBrush" Color="#171922" />
    <SolidColorBrush x:Key="LumenSurfaceHoverBrush" Color="#20232E" />
    <SolidColorBrush x:Key="LumenTextBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="LumenSecondaryTextBrush" Color="#A9AFBD" />
    <SolidColorBrush x:Key="LumenAccentBrush" Color="#89B4FA" />

    <Style x:Key="LumenNavigationButtonStyle" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource LumenTextBrush}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

</ResourceDictionary>
