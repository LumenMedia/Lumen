<Window
    x:Class="Lumen.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Lumen.Views"
    mc:Ignorable="d"
    Title="Lumen">
    <Grid x:Name="Root" Background="{ThemeResource LumenBackgroundBrush}" Loaded="Root_Loaded" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="CommandPalette_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid x:Name="LoadingRoot"
              Background="{ThemeResource LumenBackgroundBrush}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="18">
                <Image Source="ms-appx:///Assets/LumenLogo.png"
                       Width="76"
                       Height="76"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock Text="Lumen"
                           Foreground="{ThemeResource LumenTextBrush}"
                           FontFamily="Segoe UI Variable Display"
                           FontSize="34"
                           FontWeight="SemiBold"
                           CharacterSpacing="20"
                           HorizontalAlignment="Center" />
                <ProgressRing Width="42"
                              Height="42"
                              IsActive="True"
                              Foreground="{ThemeResource LumenAccentBrush}"
                              HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid x:Name="LoginRoot" Visibility="Collapsed">
            <views:LoginPage x:Name="LoginView"
                             LoginSucceeded="LoginView_LoginSucceeded" />
        </Grid>

        <Grid x:Name="ShellRoot" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarPanel" Grid.Column="0"
                    Background="{ThemeResource LumenSidebarBrush}"
                    BorderBrush="{ThemeResource LumenBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="10,10,10,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="#0AFFFFFF"
                            BorderBrush="{ThemeResource LumenBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/LumenLogo.png" Width="38" Height="38" Stretch="Uniform" />
                            <TextBlock Text="Lumen"
                                       Foreground="{ThemeResource LumenTextBrush}"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="20"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0" Spacing="4">
                        <TextBlock Text="NAVIGATION"
                                   Foreground="{ThemeResource LumenMutedBrush}"
                                   FontSize="10" FontWeight="Bold" CharacterSpacing="110"
                                   Margin="10,0,0,5" />
                        <Button x:Name="HomeNavButton" HorizontalContentAlignment="Left" Style="{StaticResource LumenNavigationButtonStyle}" Click="Home_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{ThemeResource LumenAccentSoftBrush}"/><TextBlock Text="Home" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="SearchNavButton" HorizontalContentAlignment="Left" Style="{StaticResource LumenNavigationButtonStyle}" Click="Search_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{ThemeResource LumenAccentSoftBrush}"/><TextBlock Text="Search" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="DownloadsNavButton" HorizontalContentAlignment="Stretch" Style="{StaticResource LumenNavigationButtonStyle}" Click="Downloads_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{ThemeResource LumenAccentSoftBrush}"/>
                                    <TextBlock Text="Downloads" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border x:Name="DownloadsBadge"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        MinWidth="22"
                                        Height="22"
                                        Padding="6,0"
                                        CornerRadius="6"
                                        Background="{ThemeResource LumenAccentStrongBrush}">
                                    <TextBlock x:Name="DownloadsBadgeText"
                                               Text="0"
                                               Foreground="White"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" Margin="0,18,0,12" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="LIBRARIES" Foreground="{ThemeResource LumenMutedBrush}"
                                       FontSize="10" FontWeight="Bold" CharacterSpacing="110"
                                       Margin="10,0,0,7" />
                            <ItemsControl x:Name="LibraryNavigationList" ItemsSource="{Binding Libraries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" HorizontalContentAlignment="Left" Style="{StaticResource LumenNavigationButtonStyle}" Click="Library_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource LumenAccentSoftBrush}"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Spacing="10">
                        <Button x:Name="SettingsNavButton" HorizontalContentAlignment="Left" Style="{StaticResource LumenNavigationButtonStyle}" Click="Settings_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{ThemeResource LumenAccentSoftBrush}"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel>
                        </Button>

                        <Border Margin="0,2,0,0"
                                Padding="10,8"
                                CornerRadius="12"
                                Background="Transparent"
                                BorderBrush="{ThemeResource LumenBorderBrush}"
                                BorderThickness="1"
                                PointerPressed="Profile_PointerPressed"
                                PointerEntered="ProfileCard_PointerEntered"
                                PointerExited="ProfileCard_PointerExited"
                                ToolTipService.ToolTip="Switch Jellyfin user">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="30" Height="30">
                                    <Border Width="30"
                                            Height="30"
                                            CornerRadius="15"
                                            Background="{ThemeResource LumenSurfaceBrush}">
                                        <TextBlock Text="{Binding UserInitial}"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <Border Width="30"
                                            Height="30"
                                            CornerRadius="15"
                                            Background="Transparent">
                                        <Image Source="{Binding UserImageUrl, Converter={StaticResource ImageUrlConverter}}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="12"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Jellyfin profile" Foreground="{ThemeResource LumenMutedBrush}" FontSize="10" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,4,0,0"
                                Padding="12,10"
                                CornerRadius="12"
                                Background="{ThemeResource LumenSubtleSurfaceBrush}"
                                BorderBrush="{ThemeResource LumenBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8"
                                         VerticalAlignment="Center"
                                         Fill="{ThemeResource LumenAccentBrush}" />
                                <StackPanel Grid.Column="2" Spacing="1">
                                    <TextBlock Text="CONNECTED TO"
                                               Foreground="{ThemeResource LumenMutedBrush}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="90" />
                                    <TextBlock Text="{Binding ServerName}"
                                               Foreground="{ThemeResource LumenTextBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ServerUrl}"
                                               Foreground="{ThemeResource LumenMutedBrush}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="MusicSidebarPanel" Grid.Column="0"
                    Visibility="Collapsed"
                    Background="{ThemeResource LumenSidebarBrush}"
                    BorderBrush="{ThemeResource LumenBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="10,10,10,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="#0AFFFFFF"
                            BorderBrush="{ThemeResource LumenBorderBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="12,10">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Image Source="ms-appx:///Assets/LumenLogo.png" Width="34" Height="34" Stretch="Uniform" />
                                <StackPanel Spacing="0" VerticalAlignment="Center">
                                    <TextBlock Text="Lumen Music" Foreground="{ThemeResource LumenTextBrush}"
                                               FontFamily="Segoe UI Variable Display" FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="MusicSidebarLibraryName"
                                               Foreground="{ThemeResource LumenMutedBrush}"
                                               FontSize="10" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" Margin="0,28,0,12" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="LIBRARY" Foreground="{ThemeResource LumenMutedBrush}"
                                       FontSize="10" FontWeight="Bold" CharacterSpacing="110" Margin="10,0,0,6" />
                            <Button x:Name="MusicShellHomeButton" Tag="Home"
                                    HorizontalContentAlignment="Left" Style="{StaticResource LumenNavigationButtonStyle}"
                                    Click="MusicShellNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource LumenAccentSoftBrush}"/><TextBlock Text="Home"/></StackPanel>
                            </Button>
                            <Button x:Name="MusicShellRecentlyAddedButton" Tag="Recently Added"
                                    HorizontalContentAlignment="Left" Style="{StaticResource LumenNavigationButtonStyle}"
                                    Click="MusicShellNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE823;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource LumenAccentSoftBrush}"/><TextBlock Text="Recently Added"/></StackPanel>
                            </Button>
                            <Button x:Name="MusicShellArtistsButton" Tag="Artists"
                                    HorizontalContentAlignment="Left" Style="{StaticResource LumenNavigationButtonStyle}"
                                    Click="MusicShellNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE77B;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource LumenAccentSoftBrush}"/><TextBlock Text="Artists"/></StackPanel>
                            </Button>
                            <Button x:Name="MusicShellAlbumsButton" Tag="Albums"
                                    HorizontalContentAlignment="Left" Style="{StaticResource LumenNavigationButtonStyle}"
                                    Click="MusicShellNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE93C;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource LumenAccentSoftBrush}"/><TextBlock Text="Albums"/></StackPanel>
                            </Button>
                            <Button x:Name="MusicShellSongsButton" Tag="Songs"
                                    HorizontalContentAlignment="Left" Style="{StaticResource LumenNavigationButtonStyle}"
                                    Click="MusicShellNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8D6;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource LumenAccentSoftBrush}"/><TextBlock Text="Songs"/></StackPanel>
                            </Button>
                            <Button x:Name="MusicShellPlaylistsButton" Tag="Playlists"
                                    HorizontalContentAlignment="Left" Style="{StaticResource LumenNavigationButtonStyle}"
                                    Click="MusicShellNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8FD;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource LumenAccentSoftBrush}"/><TextBlock Text="Playlists"/></StackPanel>
                            </Button>
                            <Button x:Name="MusicShellGenresButton" Tag="Genres"
                                    HorizontalContentAlignment="Left" Style="{StaticResource LumenNavigationButtonStyle}"
                                    Click="MusicShellNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8EC;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource LumenAccentSoftBrush}"/><TextBlock Text="Genres"/></StackPanel>
                            </Button>

                            <TextBlock Text="YOUR MUSIC" Foreground="{ThemeResource LumenMutedBrush}"
                                       FontSize="10" FontWeight="Bold" CharacterSpacing="110" Margin="10,18,0,6" />
                            <Button x:Name="MusicShellFavouritesButton" Tag="Favourites"
                                    HorizontalContentAlignment="Left" Style="{StaticResource LumenNavigationButtonStyle}"
                                    Click="MusicShellNav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xEB51;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource LumenAccentSoftBrush}"/><TextBlock Text="Favourites"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <Button HorizontalContentAlignment="Left" Style="{StaticResource LumenNavigationButtonStyle}"
                                Click="MusicShellShuffle_Click" ToolTipService.ToolTip="Shuffle the music library">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B1;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource LumenAccentSoftBrush}"/><TextBlock Text="Shuffle Library"/></StackPanel>
                        </Button>
                        <Button HorizontalContentAlignment="Left"
                                Style="{StaticResource LumenPrimaryButtonStyle}"
                                Click="ReturnToLumen_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource LumenAccentSoftBrush}" FontSize="15"/>
                                <TextBlock Text="Return to Lumen" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ShellContentHost" Grid.Column="1" Padding="30,22,30,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="ShellHeader"
                        MinHeight="58"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        Padding="0,7">
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="460" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <Button x:Name="BackButton"
                                Width="40" Height="40"
                                Style="{StaticResource LumenIconButtonStyle}"
                                Click="Back_Click"
                                ToolTipService.ToolTip="Back">
                            <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="17"/>
                        </Button>
                        <TextBlock x:Name="HeaderPageTitle" Text="{Binding PageTitle}"
                                   Foreground="{ThemeResource LumenTextBrush}"
                                   FontSize="30" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Border x:Name="OfflineModeBadge"
                                Visibility="Collapsed"
                                Padding="8,4"
                                CornerRadius="8"
                                Background="{ThemeResource LumenSurface2Brush}"
                                BorderBrush="{ThemeResource LumenBorderStrongBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                          Foreground="{ThemeResource LumenAccentSoftBrush}" />
                                <TextBlock Text="Offline" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource LumenTextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border x:Name="TopSearchBorder"
                            Grid.Column="1"
                            Height="40"
                            CornerRadius="20"
                            Background="{ThemeResource LumenSearchIdleBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch">
                        <Grid>
                            <FontIcon Glyph="&#xE721;"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="15"
                                      Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="14,0,0,0"
                                      IsHitTestVisible="False" />
                            <TextBox x:Name="TopSearchBox"
                                     Background="Transparent"
                                     BorderBrush="Transparent"
                                     BorderThickness="0"
                                     PlaceholderText="Search movies, shows, people…"
                                     Padding="40,7,14,7"
                                     TextChanged="TopSearchBox_TextChanged"
                                     KeyDown="TopSearchBox_KeyDown"
                                     GotFocus="TopSearchBox_GotFocus"
                                     LostFocus="TopSearchBox_LostFocus"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     UseSystemFocusVisuals="False">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#00000000" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#00000000" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#00000000" />
                                    <SolidColorBrush x:Key="TextControlBackground" Color="#00000000" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#00000000" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#00000000" />
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                    </Border>

                    <Button x:Name="DownloadQuickButton"
                            Grid.Column="2"
                            Width="42" Height="42"
                            Style="{StaticResource LumenIconButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Downloads">
                        <Grid Width="24" Height="24">

                            <Viewbox Width="18" Height="18"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Grid Width="20" Height="20">
                                    <Path Data="M10,2 L10,12 M6,8 L10,12 L14,8 M4,16 L16,16"
                                          Stroke="{ThemeResource LumenSecondaryTextBrush}"
                                          StrokeThickness="1.65"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Grid>
                            </Viewbox>
                            <Border x:Name="DownloadQuickBadge"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    MinWidth="16" Height="15"
                                    CornerRadius="5"
                                    Background="{ThemeResource LumenAccentStrongBrush}"
                                    Margin="0,-5,-6,0"
                                    Padding="3,0">
                                <TextBlock x:Name="DownloadQuickBadgeText"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="CornerRadius" Value="16" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <Border Width="430" MaxHeight="560"
                                        Padding="16"
                                        Background="{ThemeResource LumenGlassSurfaceBrush}"
                                        BorderBrush="{ThemeResource LumenBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Downloads" Foreground="{ThemeResource LumenTextBrush}"
                                                           FontFamily="Segoe UI Variable Display"
                                                           FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="Recent downloads stay here until you clear them."
                                                           Foreground="{ThemeResource LumenMutedBrush}" FontSize="10" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button x:Name="QuickDownloadsClearButton"
                                                        Style="{StaticResource LumenSecondaryButtonStyle}"
                                                        Click="QuickDownloadsClear_Click"
                                                        ToolTipService.ToolTip="Clear completed, failed and cancelled items from this flyout">
                                                    <TextBlock Text="Clear" />
                                                </Button>
                                                <Button Style="{StaticResource LumenSecondaryButtonStyle}"
                                                        Click="QuickDownloadsViewAll_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="View all" />
                                                        <FontIcon Glyph="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <ListView x:Name="QuickDownloadsList"
                                                  SelectionMode="None"
                                                  MaxHeight="440">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,7" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="11"
                                                            Background="{ThemeResource LumenSubtleSurfaceBrush}"
                                                            BorderBrush="{ThemeResource LumenBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="5">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Title}" Foreground="{ThemeResource LumenTextBrush}"
                                                                               FontSize="13" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,0,76,0" />
                                                                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right"
                                                                               Visibility="{Binding TransferDetailsVisibility}"
                                                                               Foreground="{ThemeResource LumenAccentSoftBrush}"
                                                                               FontSize="10" FontWeight="SemiBold" />
                                                                </Grid>
                                                                <StackPanel Visibility="{Binding TransferDetailsVisibility}" Spacing="5">
                                                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Text="{Binding SpeedText}" Foreground="{ThemeResource LumenAccentSoftBrush}" FontSize="10" />
                                                                        <TextBlock Text="{Binding EtaText}" Foreground="{ThemeResource LumenMutedBrush}" FontSize="10" />
                                                                        <TextBlock Text="{Binding TransferAmountText}" Foreground="{ThemeResource LumenMutedBrush}" FontSize="10" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding Status}" Foreground="{ThemeResource LumenSecondaryTextBrush}" FontSize="10" />
                                                                    <TextBlock Text="{Binding SizeText}" Foreground="{ThemeResource LumenMutedBrush}" FontSize="10" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                                                                        VerticalAlignment="Center">
                                                                <Button Width="34" Height="34" Style="{StaticResource LumenIconButtonStyle}"
                                                                        Tag="{Binding}" Click="QuickPlay_Click"
                                                                        Visibility="{Binding PlayVisibility}" ToolTipService.ToolTip="Play offline">
                                                                    <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                                                                </Button>
                                                                <Button Width="34" Height="34" Style="{StaticResource LumenIconButtonStyle}"
                                                                        Tag="{Binding}" Click="QuickRetry_Click"
                                                                        Visibility="{Binding RetryVisibility}" ToolTipService.ToolTip="Retry">
                                                                    <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                                                                </Button>
                                                                <Button Width="34" Height="34" Style="{StaticResource LumenIconButtonStyle}"
                                                                        Tag="{Binding}" Click="QuickPause_Click"
                                                                        Visibility="{Binding PauseVisibility}" ToolTipService.ToolTip="Pause">
                                                                    <FontIcon Glyph="&#xE769;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                                                                </Button>
                                                                <Button Width="34" Height="34" Style="{StaticResource LumenIconButtonStyle}"
                                                                        Tag="{Binding}" Click="QuickResume_Click"
                                                                        Visibility="{Binding ResumeVisibility}" ToolTipService.ToolTip="Resume">
                                                                    <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                                                                </Button>
                                                                <Button Width="34" Height="34" Style="{StaticResource LumenIconButtonStyle}"
                                                                        Tag="{Binding}" Click="QuickCancel_Click"
                                                                        Visibility="{Binding CancelVisibility}" ToolTipService.ToolTip="Cancel">
                                                                    <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                                                                </Button>
                                                                <Button Width="34" Height="34" Style="{StaticResource LumenIconButtonStyle}"
                                                                        Tag="{Binding}" Click="QuickDismiss_Click"
                                                                        Visibility="{Binding RemoveVisibility}" ToolTipService.ToolTip="Remove from this flyout">
                                                                    <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    </Grid>
                </Border>

                <Frame x:Name="ContentFrame" Grid.Row="1" Margin="0,20,0,0" />

                <Border x:Name="MiniPlayer" Grid.Row="2" Visibility="Collapsed" Margin="0,14,0,0"
                        Height="110" CornerRadius="18" Background="{ThemeResource LumenGlassSurfaceBrush}"
                        BorderBrush="{ThemeResource LumenBorderStrongBrush}" BorderThickness="1" Padding="12,12"
                        PointerPressed="MiniPlayer_PointerPressed">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="58" Height="58" CornerRadius="10" Background="{ThemeResource LumenSurface2Brush}"
                                VerticalAlignment="Center">
                            <Image x:Name="MiniArtwork" Stretch="UniformToFill" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="MiniTitle" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="MiniArtist" Foreground="{ThemeResource LumenAccentSoftBrush}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="MiniAlbum" Foreground="{ThemeResource LumenMutedBrush}" FontSize="10"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Grid Grid.Column="2" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                <Button x:Name="MiniShuffleButton" Width="34" Height="34" CornerRadius="17" Padding="0"
                                        Click="MiniShuffle_Click" ToolTipService.ToolTip="Shuffle">
                                    <FontIcon Glyph="&#xE8B1;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                                </Button>
                                <Button Width="36" Height="36" CornerRadius="18" Padding="0"
                                        Click="MiniPrevious_Click" ToolTipService.ToolTip="Previous">
                                    <FontIcon Glyph="&#xE892;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                </Button>
                                <Button Width="44" Height="44" CornerRadius="22" Padding="0" Margin="3,0"
                                        Background="{ThemeResource LumenAccentGradientBrush}" Click="MiniPlayPause_Click" ToolTipService.ToolTip="Play/Pause">
                                    <FontIcon x:Name="MiniPlayPauseIcon" Glyph="&#xE769;" FontFamily="Segoe Fluent Icons" FontSize="17" />
                                </Button>
                                <Button Width="36" Height="36" CornerRadius="18" Padding="0"
                                        Click="MiniNext_Click" ToolTipService.ToolTip="Next">
                                    <FontIcon Glyph="&#xE893;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                </Button>
                                <Button x:Name="MiniRepeatButton" Width="34" Height="34" CornerRadius="17" Padding="0"
                                        Click="MiniRepeat_Click" ToolTipService.ToolTip="Repeat off">
                                    <FontIcon x:Name="MiniRepeatIcon" Glyph="&#xE8EE;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                                </Button>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,2,0,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="MiniProgress" Minimum="0" ValueChanged="MiniProgress_ValueChanged" />
                                <TextBlock x:Name="MiniTime" Grid.Column="1" Width="76" TextAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{ThemeResource LumenMutedBrush}" FontSize="9" />
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                      Foreground="{ThemeResource LumenSecondaryTextBrush}" VerticalAlignment="Center" />
                            <Slider x:Name="MiniVolume" Width="82" Minimum="0" Maximum="100" Value="100"
                                    ValueChanged="MiniVolume_ValueChanged" />
                            <Button Width="38" Height="38" CornerRadius="19" Padding="0"
                                    Click="MiniLyrics_Click" ToolTipService.ToolTip="Lyrics">
                                <FontIcon Glyph="&#xE8D2;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                            </Button>
                            <Button x:Name="MiniQueueButton" Width="38" Height="38" CornerRadius="19" Padding="0"
                                    ToolTipService.ToolTip="Up Next">
                                <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                <Button.Flyout>
                                    <Flyout Placement="TopEdgeAlignedRight">
                                        <Border Width="390" MaxHeight="480" Padding="14"
                                                Background="{ThemeResource LumenGlassSurfaceBrush}" BorderBrush="{ThemeResource LumenBorderBrush}"
                                                BorderThickness="1" CornerRadius="16">
                                            <StackPanel Spacing="10">
                                                <Grid>
                                                    <TextBlock Text="Up Next" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="MiniQueueCount" HorizontalAlignment="Right"
                                                               Foreground="{ThemeResource LumenMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                                </Grid>
                                                <ListView x:Name="MiniQueueList" MaxHeight="400" SelectionMode="None"
                                                          IsItemClickEnabled="True" ItemClick="MiniQueue_ItemClick">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Padding="8,7" ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe Fluent Icons"
                                                                          Foreground="{ThemeResource LumenAccentBrush}" FontSize="12" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" Spacing="1">
                                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"
                                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding AlbumArtist}" Foreground="{ThemeResource LumenMutedBrush}" FontSize="10"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="MiniCloseButton" Width="38" Height="38" CornerRadius="19" Padding="0"
                                    Click="MiniClose_Click" ToolTipService.ToolTip="Close player">
                                <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="CommandPalettePanel"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,86,0,0"
                Width="620"
                MaxHeight="620"
                Background="{ThemeResource LumenGlassSurfaceBrush}"
                BorderBrush="{ThemeResource LumenBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="16"
                Canvas.ZIndex="100">
            <StackPanel Spacing="10">
                <Grid>
                    <FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons"
                              FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0"
                              HorizontalAlignment="Left"/>
                    <TextBox x:Name="CommandPaletteBox"
                             PlaceholderText="Search Lumen or type a command…"
                             Padding="40,10,12,10"
                             TextChanged="CommandPaletteBox_TextChanged"
                             KeyDown="CommandPaletteBox_KeyDown"/>
                </Grid>
                <TextBlock Text="CTRL+K  •  Search titles, people and Lumen commands"
                           Foreground="{ThemeResource LumenMutedBrush}" FontSize="10" Margin="4,0"/>
                <ListView x:Name="CommandPaletteResults"
                          MaxHeight="500"
                          IsItemClickEnabled="True"
                          SelectionMode="Single"
                          ItemClick="CommandPaletteResults_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,7" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe Fluent Icons"
                                          Foreground="{ThemeResource LumenAccentSoftBrush}" FontSize="15"/>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource LumenSecondaryTextBrush}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <Grid x:Name="AccountPickerOverlay"
              Visibility="Collapsed"
              Background="#F507070A"
              Canvas.ZIndex="500">
            <Grid>
                <Border Width="780"
                        MaxWidth="900"
                        Padding="42,38,42,34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{ThemeResource LumenGlassSurfaceBrush}"
                        BorderBrush="{ThemeResource LumenBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                    <StackPanel Spacing="26">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Who’s watching?"
                                       Foreground="{ThemeResource LumenTextBrush}"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Choose a profile"
                                       Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                       FontSize="14"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="430">
                            <ItemsControl x:Name="AccountPickerList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal"
                                                       MaximumRowsOrColumns="4"
                                                       HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}"
                                                Click="AccountPickerUser_Click"
                                                Width="150"
                                                Height="180"
                                                Margin="8"
                                                Padding="10"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center">
                                            <StackPanel Width="126"
                                                        Spacing="10"
                                                        HorizontalAlignment="Center">
                                                <Border Width="104"
                                                        Height="104"
                                                        CornerRadius="52"
                                                        Background="#2A211A2C"
                                                        BorderBrush="{ThemeResource LumenBorderStrongBrush}"
                                                        BorderThickness="2"
                                                        HorizontalAlignment="Center">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initial}"
                                                                   Foreground="{ThemeResource LumenAccentSoftBrush}"
                                                                   FontSize="36"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Image Source="{Binding ImageUrl, Converter={StaticResource ImageUrlConverter}}"
                                                               Stretch="UniformToFill"
                                                               ImageFailed="AccountAvatar_ImageFailed" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{ThemeResource LumenTextBrush}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                                           FontSize="11"
                                                           TextAlignment="Center"
                                                           Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="12">
                            <Button Click="AccountPickerAdd_Click"
                                    MinWidth="132"
                                    Padding="18,11"
                                    Background="{ThemeResource LumenAccentGradientBrush}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    CornerRadius="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="15" />
                                    <TextBlock Text="Add profile" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Click="AccountPickerCancel_Click"
                                    MinWidth="106"
                                    Padding="18,11"
                                    Background="{ThemeResource LumenHoverBrush}"
                                    Foreground="{ThemeResource LumenTextBrush}"
                                    BorderBrush="{ThemeResource LumenBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Content="Cancel" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
