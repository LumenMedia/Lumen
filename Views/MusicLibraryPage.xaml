<Page
    x:Class="Lumen.Views.MusicLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <DataTemplate x:Key="AlbumCardTemplate">
            <StackPanel Width="188" Spacing="7">
                <Border Width="188" Height="188" CornerRadius="14"
                        Background="{ThemeResource LumenSurfaceBrush}"
                        BorderBrush="{ThemeResource LumenBorderBrush}" BorderThickness="1">
                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="{Binding Name}" Foreground="{ThemeResource LumenTextBrush}"
                           FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource LumenSecondaryTextBrush}"
                           FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ArtistCardTemplate">
            <StackPanel Width="176" Spacing="8" HorizontalAlignment="Center">
                <Border Width="176" Height="176" CornerRadius="88"
                        Background="{ThemeResource LumenSurfaceBrush}"
                        BorderBrush="{ThemeResource LumenBorderBrush}" BorderThickness="1">
                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="{Binding Name}" Foreground="{ThemeResource LumenTextBrush}"
                           FontSize="13" FontWeight="SemiBold" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Artist" Foreground="{ThemeResource LumenSecondaryTextBrush}"
                           FontSize="11" TextAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PlaylistCardTemplate">
            <StackPanel Width="188" Spacing="7">
                <Border Width="188" Height="188" CornerRadius="14"
                        Background="{ThemeResource LumenSurfaceBrush}"
                        BorderBrush="{ThemeResource LumenBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                        <Border Background="#55000000" />
                        <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="38"
                                  Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Name}" Foreground="{ThemeResource LumenTextBrush}"
                           FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Playlist" Foreground="{ThemeResource LumenSecondaryTextBrush}" FontSize="11" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CompactTrackTemplate">
            <Grid Width="330" Height="64" ColumnSpacing="11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="8" Background="{ThemeResource LumenSurfaceBrush}"
                        VerticalAlignment="Center">
                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource LumenSecondaryTextBrush}"
                               FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource LumenBackgroundBrush}">
        <TextBlock x:Name="MusicLibraryName" Visibility="Collapsed" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,4,18" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock x:Name="SectionTitle" Text="Home" Foreground="White"
                               FontFamily="Segoe UI Variable Display" FontSize="31" FontWeight="SemiBold" />
                    <TextBlock x:Name="SectionSubtitle" Foreground="{ThemeResource LumenSecondaryTextBrush}" FontSize="12" />
                </StackPanel>
                <TextBox x:Name="MusicSearchBox" Grid.Column="1" Height="42" CornerRadius="12"
                         PlaceholderText="Search artists, albums and songs"
                         KeyDown="MusicSearchBox_KeyDown" />
                <Button Grid.Column="2" Width="42" Height="42" CornerRadius="12" Padding="0"
                        ToolTipService.ToolTip="Search music" Click="MusicSearch_Click">
                    <FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="16" />
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <ProgressRing x:Name="BusyRing" Width="40" Height="40" IsActive="False"
                              Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{ThemeResource LumenAccentBrush}" Canvas.ZIndex="50" />

                <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="0,0,18,34" Spacing="28">

                        <StackPanel x:Name="HomePanel" Spacing="28">
                            <StackPanel x:Name="RecentlyPlayedSection" Spacing="12">
                                <Grid>
                                    <TextBlock Text="Recently Played" Foreground="White" FontSize="21" FontWeight="SemiBold" />
                                    <TextBlock Text="Pick up where you left off" HorizontalAlignment="Right"
                                               Foreground="{ThemeResource LumenSecondaryTextBrush}" FontSize="11" VerticalAlignment="Bottom" />
                                </Grid>
                                <ListView x:Name="HomeRecentlyPlayedList" ItemTemplate="{StaticResource CompactTrackTemplate}" Height="78" SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="TrackCard_ItemClick" Background="Transparent"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollMode="Enabled">
                                    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
                                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,16,0"/></Style></ListView.ItemContainerStyle>

                                </ListView>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="Recently Added" Foreground="White" FontSize="21" FontWeight="SemiBold" />
                                    <Button Content="See All" Tag="Recently Added" Click="MusicNav_Click" HorizontalAlignment="Right"
                                            Background="Transparent" BorderThickness="0" Foreground="{ThemeResource LumenAccentSoftBrush}" />
                                </Grid>
                                <ListView x:Name="HomeRecentlyAddedList" ItemTemplate="{StaticResource AlbumCardTemplate}" Height="250" SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="Album_ItemClick" Background="Transparent"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollMode="Enabled">
                                    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
                                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,18,0"/></Style></ListView.ItemContainerStyle>

                                </ListView>
                            </StackPanel>

                            <StackPanel x:Name="HomeFavouriteSection" Spacing="12">
                                <Grid>
                                    <TextBlock Text="Favourite Albums" Foreground="White" FontSize="21" FontWeight="SemiBold" />
                                    <Button Content="See All" Tag="Favourites" Click="MusicNav_Click" HorizontalAlignment="Right"
                                            Background="Transparent" BorderThickness="0" Foreground="{ThemeResource LumenAccentSoftBrush}" />
                                </Grid>
                                <ListView x:Name="HomeFavouriteAlbumsList" ItemTemplate="{StaticResource AlbumCardTemplate}" Height="250" SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="Album_ItemClick" Background="Transparent"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollMode="Enabled">
                                    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
                                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,18,0"/></Style></ListView.ItemContainerStyle>

                                </ListView>
                            </StackPanel>

                            <StackPanel x:Name="HomeFavouriteArtistsSection" Spacing="12">
                                <Grid>
                                    <TextBlock Text="Favourite Artists" Foreground="White" FontSize="21" FontWeight="SemiBold" />
                                    <Button Content="See All" Tag="Favourites" Click="MusicNav_Click" HorizontalAlignment="Right"
                                            Background="Transparent" BorderThickness="0" Foreground="{ThemeResource LumenAccentSoftBrush}" />
                                </Grid>
                                <ListView x:Name="HomeFavouriteArtistsList" ItemTemplate="{StaticResource ArtistCardTemplate}" Height="238"
                                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Artist_ItemClick" Background="Transparent"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollMode="Enabled">
                                    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
                                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,22,0"/></Style></ListView.ItemContainerStyle>
                                </ListView>
                            </StackPanel>

                            <StackPanel x:Name="HomePlaylistSection" Spacing="12">
                                <Grid>
                                    <TextBlock Text="Playlists" Foreground="White" FontSize="21" FontWeight="SemiBold" />
                                    <Button Content="See All" Tag="Playlists" Click="MusicNav_Click" HorizontalAlignment="Right"
                                            Background="Transparent" BorderThickness="0" Foreground="{ThemeResource LumenAccentSoftBrush}" />
                                </Grid>
                                <ListView x:Name="HomePlaylistsList" ItemTemplate="{StaticResource PlaylistCardTemplate}" Height="250" SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="Playlist_ItemClick" Background="Transparent"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollMode="Enabled">
                                    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
                                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,18,0"/></Style></ListView.ItemContainerStyle>

                                </ListView>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="AlbumsPanel" Visibility="Collapsed" Spacing="14">
                            <GridView x:Name="AlbumsGrid" ItemTemplate="{StaticResource AlbumCardTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Album_ItemClick"
                                      HorizontalAlignment="Stretch">
                                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,18,24"/></Style></GridView.ItemContainerStyle>

                            </GridView>
                        </StackPanel>

                        <StackPanel x:Name="ArtistsPanel" Visibility="Collapsed" Spacing="14">
                            <GridView x:Name="ArtistsGrid" ItemTemplate="{StaticResource ArtistCardTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Artist_ItemClick"
                                      HorizontalAlignment="Stretch">
                                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,24,26"/></Style></GridView.ItemContainerStyle>

                            </GridView>
                        </StackPanel>

                        <StackPanel x:Name="SongsPanel" Visibility="Collapsed" Spacing="12">
                            <Grid Margin="16,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="220"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                <TextBlock Text="#" Foreground="{ThemeResource LumenMutedBrush}" FontSize="10" />
                                <TextBlock Grid.Column="1" Text="TITLE" Foreground="{ThemeResource LumenMutedBrush}" FontSize="10" />
                                <TextBlock Grid.Column="2" Text="ARTIST" Foreground="{ThemeResource LumenMutedBrush}" FontSize="10" />
                                <TextBlock Grid.Column="3" Text="ALBUM" Foreground="{ThemeResource LumenMutedBrush}" FontSize="10" />
                                <TextBlock Grid.Column="4" Text="TIME" Foreground="{ThemeResource LumenMutedBrush}" FontSize="10" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Background="{ThemeResource LumenGlassSurfaceBrush}" CornerRadius="16" BorderBrush="{ThemeResource LumenBorderBrush}" BorderThickness="1">
                                <ListView x:Name="SongsList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Song_ItemClick" Background="Transparent">
                                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="16,10" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="220"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Number}" Foreground="{ThemeResource LumenMutedBrush}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Year}" Foreground="{ThemeResource LumenMutedBrush}" FontSize="10" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Artist}" Foreground="{ThemeResource LumenSecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding Album}" Foreground="{ThemeResource LumenSecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Text="{Binding Duration}" Foreground="{ThemeResource LumenSecondaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PlaylistsPanel" Visibility="Collapsed" Spacing="14">
                            <GridView x:Name="PlaylistsGrid" ItemTemplate="{StaticResource PlaylistCardTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Playlist_ItemClick" HorizontalAlignment="Stretch">
                                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,18,24"/></Style></GridView.ItemContainerStyle>

                            </GridView>
                        </StackPanel>

                        <StackPanel x:Name="GenresPanel" Visibility="Collapsed" Spacing="14">
                            <GridView x:Name="GenresGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Genre_ItemClick" HorizontalAlignment="Stretch">
                                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,14,14"/></Style></GridView.ItemContainerStyle>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="220" Height="92" CornerRadius="14" Background="{ThemeResource LumenSubtleSurfaceBrush}"
                                                BorderBrush="{ThemeResource LumenBorderBrush}" BorderThickness="1" Padding="18">
                                            <Grid>
                                                <FontIcon Glyph="&#xE8EC;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#70B48CFF"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CountText}" Foreground="{ThemeResource LumenSecondaryTextBrush}" FontSize="11" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>

                        <StackPanel x:Name="FavouritesPanel" Visibility="Collapsed" Spacing="28">
                            <StackPanel x:Name="FavouriteAlbumsSection" Spacing="12">
                                <TextBlock Text="Albums" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                <GridView x:Name="FavouriteAlbumsGrid" ItemTemplate="{StaticResource AlbumCardTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Album_ItemClick">
                                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                    <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,18,22"/></Style></GridView.ItemContainerStyle>

                                </GridView>
                            </StackPanel>
                            <StackPanel x:Name="FavouriteArtistsSection" Spacing="12">
                                <TextBlock Text="Artists" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                <GridView x:Name="FavouriteArtistsGrid" ItemTemplate="{StaticResource ArtistCardTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Artist_ItemClick">
                                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                    <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,24,22"/></Style></GridView.ItemContainerStyle>

                                </GridView>
                            </StackPanel>
                            <StackPanel x:Name="FavouriteSongsSection" Spacing="12">
                                <TextBlock Text="Songs" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                <Border Background="{ThemeResource LumenGlassSurfaceBrush}" CornerRadius="16" BorderBrush="{ThemeResource LumenBorderBrush}" BorderThickness="1">
                                    <ListView x:Name="FavouriteSongsList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="FavouriteSong_ItemClick" Background="Transparent">
                                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="16,10" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="220"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Artist}" Foreground="{ThemeResource LumenSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Album}" Foreground="{ThemeResource LumenSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="{ThemeResource LumenSecondaryTextBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="SearchPanel" Visibility="Collapsed" Spacing="28">
                            <StackPanel x:Name="SearchArtistsSection" Spacing="12">
                                <TextBlock Text="Artists" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                <GridView x:Name="SearchArtistsGrid" ItemTemplate="{StaticResource ArtistCardTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Artist_ItemClick">
                                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                    <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,24,22"/></Style></GridView.ItemContainerStyle>

                                </GridView>
                            </StackPanel>
                            <StackPanel x:Name="SearchAlbumsSection" Spacing="12">
                                <TextBlock Text="Albums" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                <GridView x:Name="SearchAlbumsGrid" ItemTemplate="{StaticResource AlbumCardTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Album_ItemClick">
                                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                    <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,18,22"/></Style></GridView.ItemContainerStyle>

                                </GridView>
                            </StackPanel>
                            <StackPanel x:Name="SearchSongsSection" Spacing="12">
                                <TextBlock Text="Songs" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                <Border Background="{ThemeResource LumenGlassSurfaceBrush}" CornerRadius="16" BorderBrush="{ThemeResource LumenBorderBrush}" BorderThickness="1">
                                    <ListView x:Name="SearchSongsList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="SearchSong_ItemClick" Background="Transparent">
                                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="16,10" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="220"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Artist}" Foreground="{ThemeResource LumenSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Album}" Foreground="{ThemeResource LumenSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="{ThemeResource LumenSecondaryTextBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="StatusText" Foreground="{ThemeResource LumenSecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
