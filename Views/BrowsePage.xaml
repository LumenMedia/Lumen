<Page
    x:Class="Lumen.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="4" Margin="0,0,0,18">
            <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource LumenAccentBrush}"
                       FontSize="11" FontWeight="Bold" CharacterSpacing="150"/>
            <TextBlock Text="{Binding Title}" Foreground="{ThemeResource LumenTextBrush}"
                       FontFamily="Segoe UI Variable Display" FontSize="32" FontWeight="SemiBold"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <GridView ItemsSource="{Binding Items}" IsItemClickEnabled="True" SelectionMode="None"
                          ItemClick="MediaCard_ItemClick" HorizontalAlignment="Stretch">
                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,18,24"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="170" Spacing="8"
                                        RightTapped="MediaCard_RightTapped"
                                        PointerEntered="MediaCard_PointerEntered"
                                        PointerExited="MediaCard_PointerExited">
                                <Grid Width="170" Height="255">
                                    <Border CornerRadius="12" Background="{ThemeResource LumenSurfaceBrush}">
                                        <Grid>
                                            <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="3" VerticalAlignment="Bottom"
                                                         Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                    <Grid x:Name="QuickPlayChrome"
                                          Width="170" Height="255"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Opacity="0"
                                          IsHitTestVisible="False">
                                        <Border CornerRadius="12" Background="#30000000" IsHitTestVisible="False" />
                                        <Button x:Name="QuickPlayButton"
                                                Tag="{Binding}"
                                                Click="QuickPlay_Click"
                                                Style="{StaticResource LumenPosterPlayButtonStyle}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Play">
                                            <Path Data="M 3,2 L 19,11 L 3,20 Z" Fill="White"
                                                  Width="16" Height="18" Stretch="Fill" Margin="2,0,0,0" />
                                        </Button>
                                    </Grid>
                                </Grid>
                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource LumenSecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsHitTestVisible="False">
                <ProgressRing IsActive="{Binding IsBusy}" Width="40" Height="40"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource LumenSecondaryTextBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
