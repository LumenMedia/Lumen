<Page
    x:Class="Lumen.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <DataTemplate x:Key="PosterCardTemplate">
            <Grid Width="176"
                  Tag="{Binding}"
                  RightTapped="MediaCard_RightTapped"
                  PointerEntered="MediaCard_PointerEntered"
                  PointerExited="MediaCard_PointerExited"
                  Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="260" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.RowSpan="2"
                        Tag="{Binding}"
                        Click="MediaCard_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="260" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="10" Background="{ThemeResource LumenSurfaceBrush}"
                                BorderBrush="{ThemeResource LumenBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Image x:Name="PosterArtwork"
                                       Source="{Binding ImageUrl}"
                                       Stretch="UniformToFill"
                                       Opacity="0"
                                       ImageOpened="Artwork_ImageOpened"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <CompositeTransform ScaleX="1" ScaleY="1" />
                                    </Image.RenderTransform>
                                </Image>
                                <Border VerticalAlignment="Bottom" Background="#D9000000"
                                        Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Padding="8,6,8,5">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding RemainingText}" Foreground="White" FontSize="10" />
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="3" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="2,8,2,0" Spacing="3">
                            <TextBlock Text="{Binding Name}" Foreground="{ThemeResource LumenTextBrush}"
                                       FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Grid x:Name="QuickPlayChrome"
                      Grid.Row="0"
                      Width="176"
                      Height="260"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Opacity="0"
                      IsHitTestVisible="False">
                    <Border CornerRadius="10"
                            Background="#30000000"
                            IsHitTestVisible="False" />
                    <Button x:Name="QuickPlayButton"
                            Tag="{Binding}"
                            Click="QuickPlay_Click"
                            Style="{StaticResource LumenPosterPlayButtonStyle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Play">
                        <Path Data="M 3,2 L 19,11 L 3,20 Z"
                              Fill="White"
                              Width="16"
                              Height="18"
                              Stretch="Fill"
                              Margin="2,0,0,0" />
                    </Button>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer x:Name="HomeScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="HomeSectionsPanel" Spacing="34" Padding="0,0,8,56">
            <StackPanel Spacing="14" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Height="300" CornerRadius="18" Background="{ThemeResource LumenSurface2Brush}" />
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <Border Width="176" Height="260" CornerRadius="12" Background="{ThemeResource LumenSurface2Brush}" />
                    <Border Width="176" Height="260" CornerRadius="12" Background="{ThemeResource LumenSurface2Brush}" />
                    <Border Width="176" Height="260" CornerRadius="12" Background="{ThemeResource LumenSurface2Brush}" />
                    <Border Width="176" Height="260" CornerRadius="12" Background="{ThemeResource LumenSurface2Brush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{ThemeResource LumenSecondaryTextBrush}"
                       FontSize="13" TextWrapping="Wrap" />

            <Grid x:Name="FeaturedHero" Height="600" Visibility="{Binding HasFeatured, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Image Source="{Binding FeaturedItem.BackdropUrl}" Stretch="UniformToFill" Opacity="0" ImageOpened="Artwork_ImageOpened" />
                <MediaPlayerElement x:Name="HeroTrailer"
                                    AreTransportControlsEnabled="False"
                                    AutoPlay="False"
                                    Stretch="UniformToFill"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False" />

                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FA07070A" Offset="0" />
                            <GradientStop Color="#E807070A" Offset="0.24" />
                            <GradientStop Color="#7C0B0910" Offset="0.56" />
                            <GradientStop Color="#220B0910" Offset="0.82" />
                            <GradientStop Color="#0007070A" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#42000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="0.42" />
                            <GradientStop Color="#F50B0910" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Margin="76,42,76,62">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="270" Height="405"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            CornerRadius="8" Background="#26000000" BorderBrush="{ThemeResource LumenBorderStrongBrush}" BorderThickness="1">
                        <Image Source="{Binding FeaturedItem.ImageUrl}" Stretch="UniformToFill" Opacity="0" ImageOpened="Artwork_ImageOpened" />
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="760" Spacing="13">
                        <TextBlock Text="FEATURED" Foreground="{ThemeResource LumenAccentBrush}"
                                   FontSize="11" FontWeight="Bold" CharacterSpacing="180" />
                        <TextBlock Text="{Binding FeaturedItem.Name}" Foreground="White"
                                   FontSize="54" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{Binding FeaturedItem.Year}" Foreground="{ThemeResource LumenTextBrush}" FontSize="14" />
                            <TextBlock Foreground="White" FontSize="14">
                                <Run Text="★ " />
                                <Run Text="{Binding FeaturedItem.RatingText}" />
                            </TextBlock>
                            <TextBlock Text="{Binding FeaturedItem.Type}" Foreground="{ThemeResource LumenTextBrush}" FontSize="14" />
                        </StackPanel>
                        <TextBlock Text="{Binding FeaturedItem.Overview}" Foreground="{ThemeResource LumenTextBrush}"
                                   FontSize="16" LineHeight="25" TextWrapping="Wrap"
                                   MaxLines="7" TextTrimming="CharacterEllipsis" />
                        <Button Tag="{Binding FeaturedItem}" Click="MediaCard_Click"
                                Width="158" HorizontalAlignment="Left"
                                Padding="18,10" Background="White" Foreground="#0A0B0F"
                                BorderThickness="0" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Play" Foreground="#0A0B0F" />
                                <TextBlock Text="View details" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Button x:Name="PreviousButton" Click="PreviousFeatured_Click"
                        Width="46" Height="72" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="18,0,0,0" Padding="0" Background="#32000000"
                        BorderBrush="{ThemeResource LumenBorderStrongBrush}" BorderThickness="1" Opacity="0.88">
                    <TextBlock Text="‹" FontSize="42" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="NextButton" Click="NextFeatured_Click"
                        Width="46" Height="72" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,18,0" Padding="0" Background="#32000000"
                        BorderBrush="{ThemeResource LumenBorderStrongBrush}" BorderThickness="1" Opacity="0.88">
                    <TextBlock Text="›" FontSize="42" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <Border BorderBrush="{ThemeResource LumenBorderStrongBrush}" BorderThickness="1"
                        CornerRadius="20" IsHitTestVisible="False" />

                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                        Background="#55000000" BorderBrush="{ThemeResource LumenBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="11,5">
                    <TextBlock Text="{Binding FeaturedPositionText}" Foreground="{ThemeResource LumenSecondaryTextBrush}"
                               FontSize="12" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <Grid x:Name="PersonalizedRowsGrid" ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="ContinueWatchingPanel" Grid.Column="0" Spacing="14"
                            Visibility="{Binding HasContinueWatching, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <TextBlock Text="Continue Watching" Foreground="{ThemeResource LumenTextBrush}"
                                   FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="ContinuePreviousButton" Click="ContinuePrevious_Click"
                                    Width="32" Height="32" Padding="0" Content="‹" FontSize="22"
                                    Background="{ThemeResource LumenSurfaceBrush}" BorderThickness="0" />
                            <Button x:Name="ContinueNextButton" Click="ContinueNext_Click"
                                    Width="32" Height="32" Padding="0" Content="›" FontSize="22"
                                    Background="{ThemeResource LumenSurfaceBrush}" BorderThickness="0" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="ContinueScrollViewer"
                                  HorizontalContentAlignment="Left"
                                  HorizontalScrollBarVisibility="Hidden"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled">
                        <ItemsControl x:Name="ContinueItemsControl"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding ContinueWatching}"
                                      ItemTemplate="{StaticResource PosterCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <Border x:Name="PersonalizedDivider" Grid.Column="1" Width="1" Margin="0,42,0,0" VerticalAlignment="Stretch"
                        Background="#28FFFFFF"
                        Visibility="{Binding HasBothPersonalizedRows, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <StackPanel x:Name="UpNextPanel" Grid.Column="2" Spacing="14"
                            Visibility="{Binding HasUpNext, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <TextBlock Text="Up Next" Foreground="{ThemeResource LumenTextBrush}"
                                   FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="UpNextPreviousButton" Click="UpNextPrevious_Click"
                                    Width="32" Height="32" Padding="0" Content="‹" FontSize="22"
                                    Background="{ThemeResource LumenSurfaceBrush}" BorderThickness="0" />
                            <Button x:Name="UpNextNextButton" Click="UpNextNext_Click"
                                    Width="32" Height="32" Padding="0" Content="›" FontSize="22"
                                    Background="{ThemeResource LumenSurfaceBrush}" BorderThickness="0" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="UpNextScrollViewer"
                                  HorizontalContentAlignment="Left"
                                  HorizontalScrollBarVisibility="Hidden"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled">
                        <ItemsControl x:Name="UpNextItemsControl"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding UpNext}"
                                      ItemTemplate="{StaticResource PosterCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="FavoritesPanel" Spacing="14"
                        Visibility="{Binding HasFavorites, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <TextBlock Text="Favourites" Foreground="{ThemeResource LumenTextBrush}"
                               FontSize="22" FontWeight="SemiBold" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                        <Button Click="FavoritesPrevious_Click" Width="32" Height="32" Padding="0"
                                Content="‹" FontSize="22" Background="{ThemeResource LumenSurfaceBrush}" BorderThickness="0" />
                        <Button Click="FavoritesNext_Click" Width="32" Height="32" Padding="0"
                                Content="›" FontSize="22" Background="{ThemeResource LumenSurfaceBrush}" BorderThickness="0" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="FavoritesScrollViewer"
                              HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                    <ItemsControl x:Name="FavoritesItemsControl" ItemsSource="{Binding Favorites}"
                                  ItemTemplate="{StaticResource PosterCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="ReleasedMoviesPanel" Spacing="14" Visibility="{Binding HasRecentlyReleasedMovies, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <TextBlock Text="Recently Released Movies" Foreground="{ThemeResource LumenTextBrush}" FontSize="22" FontWeight="SemiBold" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="ReleasedMoviesPreviousButton" Click="ReleasedMoviesPreviousButton_Click" Width="32" Height="32" Padding="0" Content="‹" FontSize="22" Background="{ThemeResource LumenSurfaceBrush}" BorderThickness="0" />
                        <Button x:Name="ReleasedMoviesNextButton" Click="ReleasedMoviesNextButton_Click" Width="32" Height="32" Padding="0" Content="›" FontSize="22" Background="{ThemeResource LumenSurfaceBrush}" BorderThickness="0" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="RecentlyReleasedMoviesScrollViewer" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                    <ItemsControl x:Name="RecentlyReleasedMoviesItemsControl" ItemsSource="{Binding RecentlyReleasedMovies}" ItemTemplate="{StaticResource PosterCardTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="ReleasedShowsPanel" Spacing="14" Visibility="{Binding HasRecentlyReleasedShows, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <TextBlock Text="Recently Released TV Shows" Foreground="{ThemeResource LumenTextBrush}" FontSize="22" FontWeight="SemiBold" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="ReleasedShowsPreviousButton" Click="ReleasedShowsPreviousButton_Click" Width="32" Height="32" Padding="0" Content="‹" FontSize="22" Background="{ThemeResource LumenSurfaceBrush}" BorderThickness="0" />
                        <Button x:Name="ReleasedShowsNextButton" Click="ReleasedShowsNextButton_Click" Width="32" Height="32" Padding="0" Content="›" FontSize="22" Background="{ThemeResource LumenSurfaceBrush}" BorderThickness="0" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="RecentlyReleasedShowsScrollViewer" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                    <ItemsControl x:Name="RecentlyReleasedShowsItemsControl" ItemsSource="{Binding RecentlyReleasedShows}" ItemTemplate="{StaticResource PosterCardTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="AddedMoviesPanel" Spacing="14" Visibility="{Binding HasRecentlyAddedMovies, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <TextBlock Text="Recently Added Movies" Foreground="{ThemeResource LumenTextBrush}" FontSize="22" FontWeight="SemiBold" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="AddedMoviesPreviousButton" Click="AddedMoviesPreviousButton_Click" Width="32" Height="32" Padding="0" Content="‹" FontSize="22" Background="{ThemeResource LumenSurfaceBrush}" BorderThickness="0" />
                        <Button x:Name="AddedMoviesNextButton" Click="AddedMoviesNextButton_Click" Width="32" Height="32" Padding="0" Content="›" FontSize="22" Background="{ThemeResource LumenSurfaceBrush}" BorderThickness="0" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="RecentlyAddedMoviesScrollViewer" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                    <ItemsControl x:Name="RecentlyAddedMoviesItemsControl" ItemsSource="{Binding RecentlyAddedMovies}" ItemTemplate="{StaticResource PosterCardTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="AddedShowsPanel" Spacing="14" Visibility="{Binding HasRecentlyAddedShows, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <TextBlock Text="Recently Added TV Shows" Foreground="{ThemeResource LumenTextBrush}" FontSize="22" FontWeight="SemiBold" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="AddedShowsPreviousButton" Click="AddedShowsPreviousButton_Click" Width="32" Height="32" Padding="0" Content="‹" FontSize="22" Background="{ThemeResource LumenSurfaceBrush}" BorderThickness="0" />
                        <Button x:Name="AddedShowsNextButton" Click="AddedShowsNextButton_Click" Width="32" Height="32" Padding="0" Content="›" FontSize="22" Background="{ThemeResource LumenSurfaceBrush}" BorderThickness="0" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="RecentlyAddedShowsScrollViewer" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                    <ItemsControl x:Name="RecentlyAddedShowsItemsControl" ItemsSource="{Binding RecentlyAddedShows}" ItemTemplate="{StaticResource PosterCardTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
