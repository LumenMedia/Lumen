<Page
    x:Class="Lumen.Views.PersonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="34,22,34,52" Spacing="30">
            <Button Click="Back_Click" Width="40" Height="40" Padding="0"
                    HorizontalAlignment="Left" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="18"/>
            </Button>

            <Grid ColumnSpacing="30">
                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="170" Height="170" CornerRadius="85" Background="{ThemeResource LumenSurfaceBrush}">
                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" MaxWidth="850">
                    <TextBlock Text="PERSON" Foreground="{ThemeResource LumenAccentBrush}"
                               FontSize="11" FontWeight="Bold" CharacterSpacing="160"/>
                    <TextBlock Text="{Binding Name}" Foreground="{ThemeResource LumenTextBrush}"
                               FontFamily="Segoe UI Variable Display" FontSize="38" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LifeInfo}" Foreground="{ThemeResource LumenSecondaryTextBrush}" FontSize="13"/>
                    <TextBlock Text="{Binding Overview}" Foreground="{ThemeResource LumenTextBrush}"
                               FontSize="14" TextWrapping="Wrap" LineHeight="23" MaxLines="7"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource LumenSecondaryTextBrush}"/>

            <StackPanel Spacing="14" Visibility="{Binding HasMovies, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Movies" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding Movies}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}" Click="MediaCard_Click" RightTapped="MediaCard_RightTapped"
                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,18,22">
                                <StackPanel Width="160" Spacing="7">
                                    <Border Width="160" Height="240" CornerRadius="11" Background="{ThemeResource LumenSurfaceBrush}">
                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource LumenSecondaryTextBrush}" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="14" Visibility="{Binding HasShows, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="TV Shows" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding Shows}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}" Click="MediaCard_Click" RightTapped="MediaCard_RightTapped"
                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,18,22">
                                <StackPanel Width="160" Spacing="7">
                                    <Border Width="160" Height="240" CornerRadius="11" Background="{ThemeResource LumenSurfaceBrush}">
                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource LumenSecondaryTextBrush}" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <ProgressRing IsActive="{Binding IsBusy}" Width="44" Height="44" HorizontalAlignment="Center"/>
        </StackPanel>
    </ScrollViewer>
</Page>
