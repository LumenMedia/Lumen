<Page
    x:Class="Lumen.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Margin="0,8,0,30">
            <TextBlock Text="Search Lumen"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource LumenTextBrush}"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <TextBlock Text="Movies, TV shows, music, people and more"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource LumenMutedBrush}"
                       FontSize="13" />

            <Border x:Name="SearchFieldBorder"
                    Width="760"
                    Height="54"
                    Margin="0,5,0,0"
                    CornerRadius="27"
                    Background="{ThemeResource LumenSearchIdleBrush}"
                    BorderBrush="{ThemeResource LumenBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE721;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="17"
                              Foreground="{ThemeResource LumenSecondaryTextBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False" />

                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Background="Transparent"
                             BorderBrush="Transparent"
                             BorderThickness="0"
                             PlaceholderText="Search your Jellyfin library…"
                             Padding="0,9,8,9"
                             FontSize="15"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown"
                             GotFocus="SearchBox_GotFocus"
                             LostFocus="SearchBox_LostFocus"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             UseSystemFocusVisuals="False">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#00000000" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#00000000" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#00000000" />
                            <SolidColorBrush x:Key="TextControlBackground" Color="#00000000" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#00000000" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#00000000" />
                        </TextBox.Resources>
                    </TextBox>

                    <Button Grid.Column="2"
                            Width="34"
                            Height="34"
                            Padding="0"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource LumenIconButtonStyle}"
                            Click="Search_Click"
                            ToolTipService.ToolTip="Search">
                        <FontIcon Glyph="&#xE721;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="14" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Results}"
                              HorizontalAlignment="Stretch"
                              Padding="0,2,8,42">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="196"
                                  Margin="0,0,20,26"
                                  Tag="{Binding}"
                                  RightTapped="MediaCard_RightTapped"
                                  PointerEntered="MediaCard_PointerEntered"
                                  PointerExited="MediaCard_PointerExited">
                                <Border x:Name="SearchCardShell"
                                        Background="{ThemeResource LumenSurfaceBrush}"
                                        BorderBrush="{ThemeResource LumenBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="288" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Button Grid.RowSpan="2"
                                                Tag="{Binding}"
                                                Click="Result_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                CornerRadius="14"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="288" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0"
                                                        Margin="7,7,7,0"
                                                        CornerRadius="10"
                                                        Background="{ThemeResource LumenSurface2Brush}"
                                                        BorderBrush="#18FFFFFF"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Image x:Name="PosterArtwork"
                                                               Source="{Binding ImageUrl}"
                                                               Stretch="UniformToFill"
                                                               Opacity="0"
                                                               ImageOpened="Artwork_ImageOpened"
                                                               RenderTransformOrigin="0.5,0.5">
                                                            <Image.RenderTransform>
                                                                <CompositeTransform ScaleX="1" ScaleY="1" />
                                                            </Image.RenderTransform>
                                                        </Image>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Row="1"
                                                            Margin="12,11,12,13"
                                                            Spacing="4">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{ThemeResource LumenTextBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <Grid x:Name="QuickPlayChrome"
                                              Grid.Row="0"
                                              Width="182"
                                              Height="281"
                                              Margin="0,7,0,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Top"
                                              Opacity="0"
                                              IsHitTestVisible="False">
                                            <Border CornerRadius="10"
                                                    Background="#30000000"
                                                    IsHitTestVisible="False" />
                                            <Button x:Name="QuickPlayButton"
                                                    Tag="{Binding}"
                                                    Click="QuickPlay_Click"
                                                    Style="{StaticResource LumenPosterPlayButtonStyle}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Play">
                                                <Path Data="M 3,2 L 19,11 L 3,20 Z"
                                                      Fill="White"
                                                      Width="16"
                                                      Height="18"
                                                      Stretch="Fill"
                                                      Margin="2,0,0,0" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        IsHitTestVisible="False">
                <ProgressRing IsActive="{Binding IsBusy}" Width="36" Height="36" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{ThemeResource LumenSecondaryTextBrush}"
                           FontSize="13" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
