<Page
    x:Class="Lumen.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="DownloadFilterButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource LumenSecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DownloadActionIconStyle" TargetType="Button" BasedOn="{StaticResource LumenIconButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Downloads"
                           Foreground="{ThemeResource LumenTextBrush}"
                           FontFamily="Segoe UI Variable Display"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock Text="Your offline Jellyfin library on this PC."
                           Foreground="{ThemeResource LumenSecondaryTextBrush}"
                           FontSize="13" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button Width="38" Height="38"
                        Style="{StaticResource LumenIconButtonStyle}"
                        ToolTipService.ToolTip="Download actions">
                    <FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Clear failed and cancelled" Click="ClearFailed_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE777;" FontFamily="Segoe Fluent Icons" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Delete all downloads" Click="DeleteAll_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="10*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource LumenGlassSurfaceBrush}"
                    BorderBrush="{ThemeResource LumenBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,14">
                <StackPanel Spacing="3">
                    <TextBlock Text="ACTIVE"
                               Foreground="{ThemeResource LumenMutedBrush}"
                               FontSize="10" FontWeight="Bold" CharacterSpacing="100" />
                    <TextBlock x:Name="ActiveStatText"
                               Text="0"
                               Foreground="{ThemeResource LumenTextBrush}"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Downloading or paused"
                               Foreground="{ThemeResource LumenSecondaryTextBrush}"
                               FontSize="10" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{ThemeResource LumenGlassSurfaceBrush}"
                    BorderBrush="{ThemeResource LumenBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,14">
                <StackPanel Spacing="3">
                    <TextBlock Text="OFFLINE"
                               Foreground="{ThemeResource LumenMutedBrush}"
                               FontSize="10" FontWeight="Bold" CharacterSpacing="100" />
                    <TextBlock x:Name="CompletedStatText"
                               Text="0"
                               Foreground="{ThemeResource LumenTextBrush}"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Ready to play"
                               Foreground="{ThemeResource LumenSecondaryTextBrush}"
                               FontSize="10" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{ThemeResource LumenGlassSurfaceBrush}"
                    BorderBrush="{ThemeResource LumenBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,14">
                <StackPanel Spacing="3">
                    <TextBlock Text="ON DISK"
                               Foreground="{ThemeResource LumenMutedBrush}"
                               FontSize="10" FontWeight="Bold" CharacterSpacing="100" />
                    <TextBlock x:Name="OnDiskStatText"
                               Text="0 B"
                               Foreground="{ThemeResource LumenTextBrush}"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Downloaded + partial files"
                               Foreground="{ThemeResource LumenSecondaryTextBrush}"
                               FontSize="10" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Background="{ThemeResource LumenGlassSurfaceBrush}"
                    BorderBrush="{ThemeResource LumenBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{ThemeResource LumenHoverBrush}"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe Fluent Icons"
                                      FontSize="16" Foreground="{ThemeResource LumenAccentSoftBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Download storage"
                                       Foreground="{ThemeResource LumenTextBrush}"
                                       FontWeight="SemiBold" FontSize="13" />
                            <TextBlock x:Name="FolderPathText"
                                       Foreground="{ThemeResource LumenMutedBrush}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="StoragePercentText"
                                       Foreground="{ThemeResource LumenAccentSoftBrush}"
                                       VerticalAlignment="Center"
                                       FontSize="11" FontWeight="SemiBold" />
                            <Button Width="34" Height="34"
                                    Style="{StaticResource LumenIconButtonStyle}"
                                    ToolTipService.ToolTip="Download storage options">
                                <FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="15" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="Open download folder" Click="OpenDownloadsFolder_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8E5;" FontFamily="Segoe Fluent Icons" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Change download folder…" Click="ChangeDownloadFolder_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE838;" FontFamily="Segoe Fluent Icons" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Use default download folder" Click="ResetDownloadFolder_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE777;" FontFamily="Segoe Fluent Icons" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="StorageProgressBar"
                                 Grid.Row="1"
                                 Margin="0,13,0,7"
                                 Height="6"
                                 Minimum="0" Maximum="100" />

                    <TextBlock x:Name="StorageText"
                               Grid.Row="2"
                               Foreground="{ThemeResource LumenSecondaryTextBrush}"
                               FontSize="10" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Button x:Name="AllFilterButton"
                        Tag="All"
                        Style="{StaticResource DownloadFilterButtonStyle}"
                        Click="Filter_Click">
                    <TextBlock x:Name="AllFilterText" Text="All" />
                </Button>
                <Button x:Name="ActiveFilterButton"
                        Tag="Active"
                        Style="{StaticResource DownloadFilterButtonStyle}"
                        Click="Filter_Click">
                    <TextBlock x:Name="ActiveFilterText" Text="Downloading" />
                </Button>
                <Button x:Name="CompletedFilterButton"
                        Tag="Completed"
                        Style="{StaticResource DownloadFilterButtonStyle}"
                        Click="Filter_Click">
                    <TextBlock x:Name="CompletedFilterText" Text="Completed" />
                </Button>
                <Button x:Name="FailedFilterButton"
                        Tag="Failed"
                        Style="{StaticResource DownloadFilterButtonStyle}"
                        Click="Filter_Click">
                    <TextBlock x:Name="FailedFilterText" Text="Failed" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        MaxWidth="420">
                <Border Width="64" Height="64" CornerRadius="20"
                        Background="{ThemeResource LumenHoverBrush}"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE896;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="26"
                              Foreground="{ThemeResource LumenAccentSoftBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="EmptyTitleText"
                           Text="Nothing downloaded yet"
                           Foreground="{ThemeResource LumenTextBrush}"
                           FontFamily="Segoe UI Variable Display"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />
                <TextBlock x:Name="EmptySubtitleText"
                           Text="Download a movie or episode from its details page and it will appear here."
                           Foreground="{ThemeResource LumenSecondaryTextBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </StackPanel>

            <ListView x:Name="DownloadsList"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource LumenGlassSurfaceBrush}"
                                BorderBrush="{ThemeResource LumenBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="92" Height="130"
                                        CornerRadius="11"
                                        Background="{ThemeResource LumenSurface2Brush}"
                                        VerticalAlignment="Top">
                                    <Image Source="{Binding ImageUrl, Converter={StaticResource ImageUrlConverter}}"
                                           Stretch="UniformToFill" />
                                </Border>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{ThemeResource LumenTextBrush}"
                                                       FontFamily="Segoe UI Variable Display"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Margin="14,0,0,0"
                                                Padding="10,6"
                                                CornerRadius="8"
                                                Background="{ThemeResource LumenSurface2Brush}"
                                                BorderBrush="{ThemeResource LumenBorderBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{ThemeResource LumenAccentSoftBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       MaxWidth="250"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                Margin="0,10,0,0">
                                        <Border Padding="8,4" CornerRadius="7"
                                                Background="{ThemeResource LumenSubtleSurfaceBrush}"
                                                BorderBrush="{ThemeResource LumenBorderBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding QualityText}"
                                                       Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                                       FontSize="10" />
                                        </Border>
                                        <Border Padding="8,4" CornerRadius="7"
                                                Background="{ThemeResource LumenSubtleSurfaceBrush}"
                                                BorderBrush="{ThemeResource LumenBorderBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding TotalSizeText}"
                                                       Foreground="{ThemeResource LumenMutedBrush}"
                                                       FontSize="10" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Margin="0,12,0,0"
                                                Spacing="6"
                                                Visibility="{Binding TransferDetailsVisibility}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding TransferAmountText}"
                                                           Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                                           FontSize="10" />
                                                <TextBlock Text="{Binding SpeedText}"
                                                           Foreground="{ThemeResource LumenAccentSoftBrush}"
                                                           FontSize="10" />
                                                <TextBlock Text="{Binding EtaText}"
                                                           Foreground="{ThemeResource LumenMutedBrush}"
                                                           FontSize="10" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ProgressText}"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource LumenTextBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <ProgressBar Value="{Binding Progress}"
                                                     Maximum="100"
                                                     Height="5" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="3"
                                               Margin="0,10,0,0"
                                               Text="{Binding StatusDetailText}"
                                               Foreground="{ThemeResource LumenMutedBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               MaxLines="2" />

                                    <StackPanel Grid.Row="4"
                                                Orientation="Horizontal"
                                                Spacing="7"
                                                HorizontalAlignment="Right"
                                                Margin="0,10,0,0">
                                        <Button Tag="{Binding}"
                                                Style="{StaticResource LumenPrimaryButtonStyle}"
                                                Click="Play_Click"
                                                Visibility="{Binding PlayVisibility}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                                                <TextBlock Text="Play" />
                                            </StackPanel>
                                        </Button>

                                        <Button Tag="{Binding}"
                                                Style="{StaticResource LumenPrimaryButtonStyle}"
                                                Click="Retry_Click"
                                                Visibility="{Binding RetryVisibility}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                                                <TextBlock Text="Retry" />
                                            </StackPanel>
                                        </Button>

                                        <Button Tag="{Binding}"
                                                Style="{StaticResource DownloadActionIconStyle}"
                                                Click="Pause_Click"
                                                Visibility="{Binding PauseVisibility}"
                                                ToolTipService.ToolTip="Pause download">
                                            <FontIcon Glyph="&#xE769;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                        </Button>

                                        <Button Tag="{Binding}"
                                                Style="{StaticResource DownloadActionIconStyle}"
                                                Click="Resume_Click"
                                                Visibility="{Binding ResumeVisibility}"
                                                ToolTipService.ToolTip="Resume download">
                                            <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                        </Button>

                                        <Button Tag="{Binding}"
                                                Style="{StaticResource DownloadActionIconStyle}"
                                                Click="Cancel_Click"
                                                Visibility="{Binding CancelVisibility}"
                                                ToolTipService.ToolTip="Cancel download">
                                            <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                        </Button>

                                        <Button Tag="{Binding}"
                                                Style="{StaticResource DownloadActionIconStyle}"
                                                Click="More_Click"
                                                Visibility="{Binding RemoveVisibility}"
                                                ToolTipService.ToolTip="More actions">
                                            <FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="15" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
