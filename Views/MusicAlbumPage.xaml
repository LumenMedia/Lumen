<Page
    x:Class="Lumen.Views.MusicAlbumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource LumenBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="26" Padding="6,8,22,34">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Music" Click="MusicBreadcrumb_Click"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            Foreground="{ThemeResource LumenAccentSoftBrush}"/>
                    <TextBlock Text="›" Foreground="{ThemeResource LumenMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AlbumBreadcrumbText" Foreground="{ThemeResource LumenSecondaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid ColumnSpacing="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="260" Height="260" CornerRadius="20" Background="{ThemeResource LumenSurfaceBrush}"
                            BorderBrush="{ThemeResource LumenBorderBrush}" BorderThickness="1">
                        <Image x:Name="AlbumArtwork" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="9" Margin="0,0,0,4">
                        <TextBlock Text="ALBUM" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource LumenSecondaryTextBrush}"/>
                        <TextBlock x:Name="AlbumTitle" FontSize="38" FontWeight="SemiBold" Foreground="White"
                                   TextWrapping="Wrap"/>
                        <Button x:Name="AlbumArtistButton"
                                Click="AlbumArtist_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="AlbumArtist" FontSize="18" Foreground="{ThemeResource LumenAccentSoftBrush}"/>
                        </Button>
                        <TextBlock x:Name="AlbumMeta" FontSize="13" Foreground="{ThemeResource LumenSecondaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                            <Button Content="▶  Play" Padding="20,10" Background="{ThemeResource LumenAccentGradientBrush}" Click="PlayAlbum_Click"/>
                            <Button Content="Shuffle" Padding="18,10" Click="ShuffleAlbum_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Background="{ThemeResource LumenGlassSurfaceBrush}" CornerRadius="18" BorderBrush="{ThemeResource LumenBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Padding="18,12" BorderBrush="{ThemeResource LumenBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="#" Foreground="{ThemeResource LumenMutedBrush}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="TITLE" Foreground="{ThemeResource LumenMutedBrush}" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text="ARTIST" Foreground="{ThemeResource LumenMutedBrush}" FontSize="11"/>
                            <TextBlock Grid.Column="3" Text="TIME" Foreground="{ThemeResource LumenMutedBrush}" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <ListView x:Name="TracksList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="Track_ItemClick" Background="Transparent">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="18,11" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TrackNumber}" Foreground="{ThemeResource LumenSecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DiscLabel}" Foreground="{ThemeResource LumenMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Artist}" Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                <TextBlock x:Name="StatusText" Foreground="{ThemeResource LumenSecondaryTextBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
