<Page
    x:Class="Lumen.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Background="#07070A">
        <Image Source="ms-appx:///Assets/LoginBackground.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Opacity="0.58" />

        <Rectangle Fill="#660B0910" />
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.46"
                                     GradientOrigin="0.5,0.46"
                                     RadiusX="0.72"
                                     RadiusY="0.72">
                    <GradientStop Offset="0" Color="#10000000" />
                    <GradientStop Offset="0.62" Color="#480B0910" />
                    <GradientStop Offset="1" Color="#D807070A" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="720" Padding="36,28,36,30">
                <StackPanel Width="560"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="0">

                    <Image Source="ms-appx:///Assets/LumenLogo.png"
                           Width="112"
                           Height="112"
                           Stretch="Uniform"
                           HorizontalAlignment="Center" />

                    <TextBlock Text="Lumen"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="52"
                               FontWeight="SemiLight"
                               Foreground="{ThemeResource LumenTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,0" />
                    <TextBlock Text="Your media. Beautifully lit."
                               FontFamily="Segoe UI Variable Text"
                               FontSize="16"
                               Foreground="{ThemeResource LumenSecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,24" />

                    <Border Background="{ThemeResource LumenGlassSurfaceBrush}"
                            BorderBrush="{ThemeResource LumenBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="34,30,34,28">
                        <StackPanel Spacing="0">
                            <TextBlock Text="Connect to your Jellyfin server"
                                       FontFamily="Segoe UI Variable Display"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource LumenTextBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Enter your server and account details to get started"
                                       FontSize="13"
                                       Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,24" />

                            <TextBlock Text="Server"
                                       Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="2,0,0,6" />
                            <Border Height="48"
                                    Background="#990B0910"
                                    BorderBrush="{ThemeResource LumenBorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <Grid>
                                    <FontIcon Glyph="&#xE968;"
                                              FontFamily="Segoe Fluent Icons"
                                              FontSize="15"
                                              Foreground="{ThemeResource LumenAccentSoftBrush}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="15,0,0,0"
                                              IsHitTestVisible="False" />
                                    <TextBox x:Name="ServerBox"
                                             PlaceholderText="e.g. http://192.168.1.100:8096"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="44,8,14,8"
                                             VerticalAlignment="Stretch" />
                                </Grid>
                            </Border>

                            <Border x:Name="RecentServersPanel"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource LumenSubtleSurfaceBrush}"
                                    CornerRadius="12"
                                    Padding="12,10"
                                    Margin="0,10,0,0">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="Recent servers"
                                               Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <ItemsControl x:Name="RecentServersList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding}"
                                                        Click="RememberedServer_Click"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Background="{ThemeResource LumenSubtleSurfaceBrush}"
                                                        BorderBrush="{ThemeResource LumenBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="10,7">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{ThemeResource LumenTextBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Address}"
                                                                   Foreground="{ThemeResource LumenMutedBrush}"
                                                                   FontSize="10"
                                                                   MaxWidth="180"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="12" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Username" Foreground="{ThemeResource LumenSecondaryTextBrush}" FontSize="12" Margin="2,0,0,0" />
                                    <Border Height="48" Background="#990B0910" BorderBrush="{ThemeResource LumenBorderBrush}"
                                            BorderThickness="1" CornerRadius="14">
                                        <TextBox x:Name="UsernameBox"
                                                 PlaceholderText="Jellyfin username"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="14,8"
                                                 VerticalAlignment="Stretch" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Password" Foreground="{ThemeResource LumenSecondaryTextBrush}" FontSize="12" Margin="2,0,0,0" />
                                    <Border Height="48" Background="#990B0910" BorderBrush="{ThemeResource LumenBorderBrush}"
                                            BorderThickness="1" CornerRadius="14">
                                        <PasswordBox x:Name="PasswordBox"
                                                     PlaceholderText="Password"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="14,8"
                                                     VerticalAlignment="Stretch" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="RememberMeCheck"
                                      Content="Remember this login"
                                      IsChecked="True"
                                      Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                      Margin="0,14,0,0" />

                            <InfoBar x:Name="ErrorBar"
                                     IsOpen="False"
                                     Severity="Error"
                                     IsClosable="False"
                                     Margin="0,12,0,0" />

                            <Button x:Name="SignInButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Height="50"
                                    Margin="0,18,0,0"
                                    Padding="16,0"
                                    CornerRadius="14"
                                    Background="{ThemeResource LumenAccentGradientBrush}"
                                    BorderThickness="0"
                                    Click="SignIn_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1"
                                               Text="Connect"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <FontIcon Grid.Column="2"
                                              Glyph="&#xE72A;"
                                              FontFamily="Segoe Fluent Icons"
                                              FontSize="16"
                                              Foreground="White"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <ProgressRing x:Name="Progress"
                                          IsActive="False"
                                          Width="22"
                                          Height="22"
                                          HorizontalAlignment="Center"
                                          Margin="0,14,0,0" />

                            <Grid Margin="0,14,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Height="1" Fill="{ThemeResource LumenBorderBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="OR"
                                           Foreground="{ThemeResource LumenMutedBrush}"
                                           FontSize="11"
                                           Margin="12,0" />
                                <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource LumenBorderBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Button x:Name="DiscoverButton"
                                    HorizontalAlignment="Stretch"
                                    Height="48"
                                    CornerRadius="14"
                                    Background="{ThemeResource LumenSubtleSurfaceBrush}"
                                    BorderBrush="{ThemeResource LumenBorderStrongBrush}"
                                    BorderThickness="1"
                                    Click="Discover_Click">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="10">
                                    <FontIcon Glyph="&#xE774;"
                                              FontFamily="Segoe Fluent Icons"
                                              FontSize="16"
                                              Foreground="{ThemeResource LumenAccentSoftBrush}" />
                                    <TextBlock Text="Discover servers on my network"
                                               Foreground="{ThemeResource LumenTextBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="DiscoveryStatus"
                                       Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0" />

                            <ListView x:Name="DiscoveredServersList"
                                      Visibility="Collapsed"
                                      SelectionMode="None"
                                      Margin="0,8,0,0"
                                      MaxHeight="180">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}"
                                                Click="DiscoveredServer_Click"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="{ThemeResource LumenSubtleSurfaceBrush}"
                                                BorderThickness="0"
                                                CornerRadius="12"
                                                Padding="12,9"
                                                Margin="0,0,0,6">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="White"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Address}"
                                                               Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <TextBlock Text="{Binding HealthText}"
                                                                   Foreground="{ThemeResource LumenAccentSoftBrush}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding LatencyText}"
                                                                   Foreground="{ThemeResource LumenMutedBrush}"
                                                                   FontSize="10" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <FontIcon Grid.Column="1"
                                                          Glyph="&#xE72A;"
                                                          FontFamily="Segoe Fluent Icons"
                                                          Foreground="{ThemeResource LumenAccentSoftBrush}"
                                                          VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Button x:Name="CancelButton"
                                    Content="Cancel"
                                    Click="Cancel_Click"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource LumenAccentSoftBrush}"
                                    Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Margin="0,22,0,0">
                        <FontIcon Glyph="&#xE72E;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="12"
                                  Foreground="{ThemeResource LumenMutedBrush}" />
                        <TextBlock Text="Your credentials stay on this device and are protected by Windows."
                                   Foreground="{ThemeResource LumenMutedBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
