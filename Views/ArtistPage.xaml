<Page
    x:Class="Lumen.Views.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource LumenBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="30" Padding="6,8,22,40">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Music"
                            Click="MusicBreadcrumb_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Foreground="{ThemeResource LumenAccentSoftBrush}" />
                    <TextBlock Text="›"
                               Foreground="{ThemeResource LumenMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ArtistBreadcrumbText"
                               Foreground="{ThemeResource LumenSecondaryTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Grid ColumnSpacing="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="220"
                            Height="220"
                            CornerRadius="110"
                            Background="{ThemeResource LumenSurfaceBrush}"
                            BorderBrush="{ThemeResource LumenBorderBrush}"
                            BorderThickness="1">
                        <Image x:Name="ArtistArtwork" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="9">
                        <TextBlock Text="ARTIST"
                                   Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="ArtistTitle"
                                   Foreground="White"
                                   FontSize="42"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ArtistMeta"
                                   Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                   FontSize="13" />
                        <TextBlock x:Name="ArtistOverview"
                                   Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                   FontSize="13"
                                   MaxLines="4"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"
                                   MaxWidth="900" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                            <Button Content="▶  Play"
                                    Padding="20,10"
                                    Background="{ThemeResource LumenAccentGradientBrush}"
                                    Click="PlayArtist_Click" />
                            <Button Content="Shuffle"
                                    Padding="18,10"
                                    Click="ShuffleArtist_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="14">
                    <TextBlock Text="Albums"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <GridView x:Name="AlbumsGrid"
                              IsItemClickEnabled="True"
                              ItemClick="Album_ItemClick"
                              SelectionMode="None"
                              HorizontalAlignment="Stretch">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,18,18" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="190" Spacing="7">
                                    <Border Width="190" Height="190"
                                            CornerRadius="14"
                                            Background="{ThemeResource LumenSurfaceBrush}">
                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="Songs"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SongCountText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Foreground="{ThemeResource LumenSecondaryTextBrush}" />
                    </Grid>

                    <Border Background="{ThemeResource LumenGlassSurfaceBrush}"
                            BorderBrush="{ThemeResource LumenBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <ListView x:Name="SongsList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="Song_ItemClick"
                                  Background="Transparent">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="16,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}"
                                                   Foreground="{ThemeResource LumenMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Album}"
                                                       Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Artist}"
                                                   Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Duration}"
                                                   Foreground="{ThemeResource LumenSecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="StatusText"
                           Foreground="{ThemeResource LumenSecondaryTextBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
